{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "UUID": "dev.sheepy.display-knob",
  "Name": "Display Knob",
  "Version": "1.0.1.0",
  "Author": "sheepy",
  "URL": "https://sheepy.dev",
  "Description": "Input switching, brightness, volume, and mute for the LG 32\" UltraFine evo 6K (32U990A) over DDC.",
  "Category": "Display Knob",
  "CategoryIcon": "imgs/category-icon",
  "Icon": "imgs/plugin-icon",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.4"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "disabled"
  },
  "Actions": [
    {
      "UUID": "dev.sheepy.display-knob.switch-input",
      "Name": "Switch Input",
      "Tooltip": "Switch the UltraFine evo 6K to Thunderbolt, HDMI, or DisplayPort",
      "Icon": "imgs/switch-icon",
      "PropertyInspectorPath": "ui/switch-input.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/input-inactive",
          "TitleAlignment": "bottom",
          "Name": "Inactive"
        },
        {
          "Image": "imgs/input-active",
          "TitleAlignment": "bottom",
          "Name": "Active"
        }
      ]
    },
    {
      "UUID": "dev.sheepy.display-knob.brightness",
      "Name": "Brightness",
      "Tooltip": "Brightness up/down for the UltraFine evo 6K (one step per press)",
      "Icon": "imgs/brightness-icon",
      "PropertyInspectorPath": "ui/brightness.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/brightness-key",
          "TitleAlignment": "bottom",
          "Name": "Brightness"
        }
      ]
    },
    {
      "UUID": "dev.sheepy.display-knob.volume",
      "Name": "Volume",
      "Tooltip": "Speaker volume up/down for the UltraFine evo 6K (one step per press)",
      "Icon": "imgs/volume-icon",
      "PropertyInspectorPath": "ui/volume.html",
      "Controllers": [
        "Keypad"
      ],
      "States": [
        {
          "Image": "imgs/volume-key",
          "TitleAlignment": "bottom",
          "Name": "Volume"
        }
      ]
    },
    {
      "UUID": "dev.sheepy.display-knob.mute",
      "Name": "Mute",
      "Tooltip": "Toggle the UltraFine evo 6K speaker mute",
      "Icon": "imgs/mute-icon",
      "Controllers": [
        "Keypad"
      ],
      "DisableAutomaticStates": true,
      "States": [
        {
          "Image": "imgs/volume-key",
          "TitleAlignment": "bottom",
          "Name": "Unmuted"
        },
        {
          "Image": "imgs/mute-key",
          "TitleAlignment": "bottom",
          "Name": "Muted"
        }
      ]
    }
  ]
}
